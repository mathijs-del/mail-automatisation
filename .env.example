# Kopieer naar .env en vul in. Nooit .env committen.

# --- Claude ---------------------------------------------------------------
# platform.claude.com -> API keys. Zet een spend limit op de key.
ANTHROPIC_API_KEY=

# --- Trajectdata ----------------------------------------------------------
# Sheet ID staat in de URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=AI_Trajectdata

# --- Logsheet -------------------------------------------------------------
# Mag hetzelfde spreadsheet zijn als hierboven, ander tabblad.
# Kolommen: datum | afzender | categorie | urgentie | concept_gemaakt |
#           waarschuwing | resultaat | messageId | threadId | subject | triage_json
LOG_SHEET_ID=
LOG_SHEET_TAB=AI_LOG

# --- Google auth (alleen voor de scripts, niet voor n8n) ------------------
# validate-sheet.js: pad naar een service-account JSON-sleutel met leestoegang
# tot de sheet (service-account e-mailadres als "Viewer" toevoegen).
GOOGLE_APPLICATION_CREDENTIALS=

# setup-labels.js: OAuth-gegevens van de mailbox zelf (info@thenext-gen.com).
# n8n gebruikt zijn eigen credential — deze zijn alleen voor het script.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- n8n ------------------------------------------------------------------
N8N_URL=https://thenext-gen.app.n8n.cloud
# ID van de geïmporteerde ai-draft-core workflow (staat in de URL van die
# workflow in n8n). Nodig in gmail-adapter-drafts.
CORE_WORKFLOW_ID=
