# Kopieer naar .env en vul in. Nooit .env committen.

# platform.claude.com
ANTHROPIC_API_KEY=

# Sheet ID staat in de URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=AI_Trajectdata

# Pad naar een service-account JSON-sleutel met leestoegang tot de sheet
# (service account e-mailadres moet als "Viewer" aan de sheet zijn toegevoegd).
# Alleen nodig voor scripts/validate-sheet.js buiten n8n om — n8n zelf
# gebruikt zijn eigen OAuth-credential voor Gmail + Sheets + Drive.
GOOGLE_APPLICATION_CREDENTIALS=

# n8n instance URL (self-hosted of Cloud)
N8N_URL=
